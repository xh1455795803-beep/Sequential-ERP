    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  a { text-decoration: none; color: inherit; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 24px; }
  .mono { font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace; }

  /* ---------- Logo ---------- */
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo svg { display: block; flex: none; }
  .logo b { font-size: 19px; font-weight: 800; letter-spacing: .01em; color: var(--text); }
  .logo b i { font-style: normal; color: var(--orange-500); }

  /* ---------- Nav ---------- */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    height: 66px; display: flex; align-items: center;
    background: rgba(247, 248, 250, .86);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color .3s, box-shadow .3s, background .3s;
  }
  nav.scrolled { border-bottom-color: var(--line); box-shadow: 0 1px 14px rgba(15, 23, 42, .06); background: rgba(255,255,255,.9); }
  nav .wrap { display: flex; align-items: center; gap: 34px; width: 100%; }
  nav .links { display: flex; gap: 27px; font-size: 14.5px; color: var(--text-2); margin-left: 10px; font-weight: 500; }
  nav .links a { position: relative; transition: color .18s; }
  nav .links a::after {
    content: ""; position: absolute; left: 0; right: 100%; bottom: -5px; height: 2px;
    background: var(--orange-500); border-radius: 2px; transition: right .22s ease;
  }
  nav .links a:hover { color: var(--orange-500); }
  nav .links a:hover::after { right: 0; }
  nav .actions { margin-left: auto; display: flex; align-items: center; gap: 12px; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: 10px; font-weight: 600; font-size: 14.5px; cursor: pointer;
    border: none; transition: all .18s ease; white-space: nowrap; font-family: inherit;
  }
  /* 主按钮：品牌暖橙 */
  .btn-primary {
    background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
    color: #fff; padding: 11px 22px;
    box-shadow: 0 1px 2px rgba(154, 52, 18, .28), 0 6px 18px -6px rgba(154, 52, 18, .5);
  }
  .btn-primary:hover {
    background: linear-gradient(135deg, var(--orange-400), var(--orange-500));
    transform: translateY(-1px);
    box-shadow: 0 2px 4px rgba(154, 52, 18, .3), 0 10px 26px -8px rgba(154, 52, 18, .6);
  }
  .btn-ghost-light { background: rgba(255,255,255,.1); color: #E8EEF8; padding: 11px 22px; border: 1px solid rgba(255,255,255,.24); }
  .btn-ghost-light:hover { background: rgba(255,255,255,.18); color: #fff; border-color: rgba(255,255,255,.4); }
  .btn-outline { background: transparent; color: var(--text-2); padding: 9px 18px; border: 1px solid var(--line); }
  .btn-outline:hover { color: var(--orange-600); border-color: var(--orange-300); background: #FFF7ED; }
  .btn-lg { padding: 14px 30px; font-size: 15.5px; border-radius: 12px; }

  /* ---------- Hero ---------- */
  header.hero {
    position: relative; overflow: hidden; color: #fff;
    background:
      radial-gradient(920px 440px at 80% -12%, rgba(234, 88, 12, .22), transparent 62%),
      radial-gradient(720px 400px at 6% 108%, rgba(62, 126, 166, .26), transparent 60%),
      linear-gradient(158deg, var(--navy-950) 4%, var(--navy-900) 46%, var(--navy-800) 100%);
    padding: 150px 0 100px;
  }
  /* 航线网格 */
  header.hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(148, 163, 184, .06) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(148, 163, 184, .06) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 88% 72% at 50% 26%, #000 28%, transparent 78%);
    mask-image: radial-gradient(ellipse 88% 72% at 50% 26%, #000 28%, transparent 78%);
  }
  /* 装饰航线弧 */
  header.hero::after {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background:
      radial-gradient(circle at 86% 22%, rgba(253, 186, 116, .16) 0, transparent 26%),
      radial-gradient(circle at 12% 78%, rgba(95, 163, 201, .14) 0, transparent 30%);
  }
  .hero .wrap { position: relative; z-index: 1; display: grid; grid-template-columns: 1.06fr .94fr; gap: 58px; align-items: center; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12.5px; font-weight: 600; letter-spacing: .05em;
    color: #FDBA74; background: rgba(234, 88, 12, .14);
    border: 1px solid rgba(253, 186, 116, .34);
    border-radius: 999px; padding: 6px 14px; margin-bottom: 22px;
  }
  .hero-badge svg { flex: none; }
  .hero h1 {
    font-size: clamp(33px, 4.5vw, 52px); line-height: 1.2; font-weight: 800;
    letter-spacing: -.01em; margin-bottom: 20px;
  }
  .hero h1 em {
    font-style: normal;
    background: linear-gradient(94deg, #FDBA74 1%, #F97316 55%, #FB923C 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero p.lead { font-size: 17px; color: #B9C7DD; max-width: 490px; margin-bottom: 34px; }
  .hero .cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-meta { margin-top: 32px; display: flex; gap: 26px; color: #8397B6; font-size: 13px; flex-wrap: wrap; }
  .hero-meta b { color: #E3EAF6; font-weight: 700; }

  /* Hero dashboard mock */
  .mock { position: relative; transform: perspective(1400px) rotateY(-7deg) rotateX(2deg); }
  .mock-card {
    background: linear-gradient(160deg, rgba(30, 52, 92, .72), rgba(11, 27, 51, .82));
    border: 1px solid rgba(120, 152, 205, .30);
    border-radius: 16px; padding: 18px;
    box-shadow: 0 30px 70px -22px rgba(3, 10, 24, .9), inset 0 1px 0 rgba(255,255,255,.06);
  }
  .mock-top { display: flex; align-items: center; gap: 7px; margin-bottom: 14px; }
  .mock-top i { width: 9px; height: 9px; border-radius: 50%; background: rgba(148,163,184,.55); }
  .mock-top i:first-child { background: rgba(234,88,12,.7); }
  .mock-title { font-size: 12px; color: #9BAEC9; margin-left: 6px; letter-spacing: .08em; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
  .kpi { background: rgba(255, 255, 255, .085); border: 1px solid rgba(148, 178, 224, .26); border-radius: 10px; padding: 12px 13px; }
  .kpi small { display: block; color: #9FB2CE; font-size: 11px; margin-bottom: 5px; letter-spacing: .04em; }
  .kpi b { font-size: 18px; font-weight: 700; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,.35); }
  .kpi span { font-size: 11px; margin-left: 6px; color: #4ADE80; font-weight: 600; }
  .kpi span.down { color: #F87171; }
  .chart-box { background: rgba(255, 255, 255, .06); border: 1px solid rgba(148, 178, 224, .20); border-radius: 10px; padding: 12px; }
  .float-chip {
    position: absolute; display: flex; align-items: center; gap: 9px;
    background: linear-gradient(140deg, rgba(22, 42, 78, .97), rgba(11, 27, 51, .97));
    border: 1px solid rgba(96,165,250,.38);
    border-radius: 12px; padding: 10px 14px; font-size: 12.5px; color: #E3EAF6;
    box-shadow: 0 16px 40px -12px rgba(3,10,24,.9);
  }
  .float-chip svg { flex: none; }
  .chip-a { top: -20px; right: -14px; animation: bob 5.2s ease-in-out infinite; }
  .chip-b { bottom: -18px; left: -18px; animation: bob 6s ease-in-out .8s infinite; }
  @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }

  /* ---------- Trust bar ---------- */
  .trust { border-bottom: 1px solid var(--line); background: #fff; padding: 28px 0; }
  .trust .wrap { display: flex; align-items: center; gap: 34px; flex-wrap: wrap; justify-content: center; }
  .trust small { color: var(--text-3); font-size: 12.5px; letter-spacing: .12em; font-weight: 700; }
  .trust span {
    display: inline-flex; align-items: center; gap: 7px;
    color: var(--text-2); font-weight: 700; font-size: 14.5px; letter-spacing: .02em;
    opacity: .68; transition: opacity .2s, color .2s;
  }
  .trust span::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--orange-400); flex: none; }
  .trust span:hover { opacity: 1; color: var(--navy-900); }

  /* ---------- Sections ---------- */
  section { padding: 90px 0; }
  .sec-head { text-align: center; max-width: 660px; margin: 0 auto 56px; }
  .sec-tag {
    display: inline-block; color: var(--orange-600); background: #FFF7ED;
    border: 1px solid #FED7AA; font-size: 12.5px; font-weight: 700;
    letter-spacing: .1em; padding: 5px 14px; border-radius: 999px; margin-bottom: 16px;
  }
  .sec-head h2 { font-size: clamp(26px, 3.2vw, 36px); font-weight: 800; letter-spacing: -.01em; margin-bottom: 12px; }
  .sec-head p { color: var(--text-2); font-size: 15.5px; }

  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .feat {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 26px;
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }
  .feat:hover { transform: translateY(-4px); border-color: #FDBA74; box-shadow: 0 18px 44px -18px rgba(15, 23, 42, .18); }
  .feat .ico {
    width: 44px; height: 44px; border-radius: 11px; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(140deg, #FFF7ED, #FFEDD5); color: var(--orange-600); margin-bottom: 17px;
  }
  .feat h3 { font-size: 16.5px; font-weight: 700; margin-bottom: 8px; }
  .feat p { color: var(--text-2); font-size: 14px; }

  /* AI banner */
  section.ai-sec { padding-top: 20px; }
  .ai-banner {
    position: relative; overflow: hidden; border-radius: 22px; color: #fff; padding: 58px 56px;
    background:
      radial-gradient(620px 300px at 88% 0%, rgba(249, 115, 22, .26), transparent 60%),
      radial-gradient(700px 340px at 8% 100%, rgba(62, 126, 166, .3), transparent 62%),
      linear-gradient(140deg, var(--navy-950), var(--navy-800));
  }
  .ai-banner::before {
    content: ""; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(148,163,184,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,.05) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: radial-gradient(ellipse 70% 90% at 50% 50%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 90% at 50% 50%, #000 20%, transparent 75%);
  }
  .ai-banner .inner { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; }
  .ai-banner h2 { font-size: 27px; font-weight: 800; margin-bottom: 10px; }
  .ai-banner p { color: #B9C7DD; max-width: 560px; font-size: 15px; }
  .ai-tags { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
  .ai-tags span { font-size: 13px; color: #FDBA74; border: 1px solid rgba(251,146,60,.4); background: rgba(249,115,22,.13); padding: 6px 14px; border-radius: 999px; }
  .ai-tags span.t { color: #7DD3FC; border-color: rgba(56,189,248,.35); background: rgba(14,165,233,.12); }

  /* Pricing */
  section.pricing-sec { padding-top: 30px; }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }
  .plan {
    background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 30px 28px;
    display: flex; flex-direction: column; position: relative;
    transition: transform .22s ease, box-shadow .22s ease;
  }
  .plan:hover { transform: translateY(-4px); box-shadow: 0 20px 48px -20px rgba(15, 23, 42, .16); }
  .plan.hot { border: 2px solid var(--orange-500); box-shadow: 0 24px 54px -22px rgba(234, 88, 12, .35); }
  .hot-tag {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
    background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
    color: #fff; font-size: 12px; font-weight: 700;
    padding: 4px 16px; border-radius: 999px; letter-spacing: .06em; white-space: nowrap;
  }
  .plan h3 { font-size: 17px; font-weight: 700; }
  .plan .desc { color: var(--text-3); font-size: 13px; margin: 4px 0 18px; }
  .plan .price { font-size: 40px; font-weight: 800; letter-spacing: -.02em; }
  .plan .price small { font-size: 14px; color: var(--text-3); font-weight: 500; letter-spacing: 0; }
  .plan ul { list-style: none; margin: 20px 0 26px; display: grid; gap: 11px; flex: 1; }
  .plan li { display: flex; gap: 10px; align-items: flex-start; color: var(--text-2); font-size: 14px; }
  .plan li svg { flex: none; margin-top: 3px; }
  .plan .btn { width: 100%; }
  .plan.hot .btn { background: linear-gradient(135deg, var(--orange-500), var(--orange-600)); color: #fff; padding: 13px 22px; }
  .plan.hot .btn:hover { background: linear-gradient(135deg, var(--orange-400), var(--orange-500)); }
  .plan:not(.hot) .btn { background: #F1F5F9; color: var(--text); padding: 13px 22px; }
  .plan:not(.hot) .btn:hover { background: #E4E8EF; }

  /* Final CTA */
  section.final-sec { padding-top: 12px; }
  .final {
    text-align: center; color: #fff; padding: 76px 32px; position: relative; overflow: hidden;
    background:
      radial-gradient(600px 280px at 50% -30%, rgba(249, 115, 22, .3), transparent 65%),
      linear-gradient(150deg, var(--navy-950), var(--navy-800));
    border-radius: 24px;
  }
  .final::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(148,163,184,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,.05) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 80% 100% at 50% 0%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse 80% 100% at 50% 0%, #000 10%, transparent 70%);
  }
  .final > * { position: relative; }
  .final h2 { font-size: clamp(26px, 3vw, 34px); font-weight: 800; margin-bottom: 12px; letter-spacing: -.01em; }
  .final p { color: #B9C7DD; margin-bottom: 30px; }

  /* Footer */
  footer { border-top: 1px solid var(--line); padding: 36px 0; color: var(--text-3); font-size: 13.5px; background: #fff; }
  footer .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  footer .logo b { font-size: 16px; }
  footer .fright { display: flex; gap: 22px; }
  footer a { transition: color .18s; }
  footer a:hover { color: var(--orange-600); }

  /* Reveal animation */
  .rv { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
  .rv.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .rv { opacity: 1; transform: none; transition: none; }
    .float-chip { animation: none !important; }
    html { scroll-behavior: auto; }
  }

  @media (max-width: 960px) {
    .hero .wrap { grid-template-columns: 1fr; gap: 48px; }
    .mock { transform: none; }
    .grid-3 { grid-template-columns: 1fr 1fr; }
    .plans { grid-template-columns: 1fr; }
    .ai-banner .inner { grid-template-columns: 1fr; }
    nav .links { display: none; }
    .ai-banner { padding: 44px 32px; }
  }
  @media (max-width: 620px) {
    .grid-3 { grid-template-columns: 1fr; }
    header.hero { padding: 122px 0 76px; }
    .kpis { grid-template-columns: 1fr 1fr; }
    .hero .cta .btn { width: 100%; }
    .final { padding: 56px 22px; }
    nav .actions .btn-outline { display: none; }
  }

  .mock-demo{margin-left:auto;font-size:10.5px;font-weight:600;letter-spacing:.08em;color:#FDBA74;background:rgba(234,88,12,.18);padding:2px 9px;border-radius:999px;white-space:nowrap}
</style>
</head>
