<style>
  /* ============================================================
     Thalvior 品牌规范 v1 · 深海航运（Deep-Sea Shipping）
     深蓝 = 海洋与航线   暖橙 = 货柜与中国制造的活力
     ============================================================ */
  :root {
    /* 深蓝 */
    --navy-950: #061020;
    --navy-900: #0B1B33;
    --navy-800: #112544;
    --navy-700: #1B3557;
    /* 暖橙（品牌主色） */
    --orange-600: #C2410C;
    --orange-500: #EA580C;
    --orange-400: #F97316;
    --orange-300: #FDBA74;
    /* 海港青（辅助） */
    --harbor-500: #3E7EA6;
    --harbor-400: #5FA3C9;
    /* 中性 */
    --bg: #F7F8FA;
    --card: #FFFFFF;
    --text: #0F172A;
    --text-2: #475569;
    --text-3: #8494A9;
    --line: #E4E8EF;
    --line-soft: #EEF2F7;
    /* 语义 */
    --up: #16A34A;
    --down: #DC2626;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
