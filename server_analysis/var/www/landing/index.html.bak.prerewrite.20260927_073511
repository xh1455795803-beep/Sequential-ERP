<style>
  :root {
    --navy-950: #081426;
    --navy-900: #0B1B33;
    --navy-800: #0F1E3D;
    --navy-700: #16305C;
    --blue-600: #2563EB;
    --blue-500: #3B82F6;
    --blue-400: #60A5FA;
    --sky-500: #0EA5E9;
    --orange-500: #F97316;
    --bg: #F8FAFC;
    --card: #FFFFFF;
    --text: #0F172A;
    --text-2: #475569;
    --text-3: #94A3B8;
    --line: #E2E8F0;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: Inter, -apple-system, "SF Pro Text", "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    letter-spacing: 0.01em;
  }
  a { text-decoration: none; color: inherit; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 24px; }

  /* ---------- Logo ---------- */
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo svg { display: block; }
  .logo b { font-size: 19px; font-weight: 700; letter-spacing: 0.02em; color: var(--text); }
  .logo b i { font-style: normal; color: var(--blue-600); }

  /* ---------- Nav ---------- */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    height: 64px; display: flex; align-items: center;
    background: rgba(248, 250, 252, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color .3s, box-shadow .3s;
  }
  nav.scrolled { border-bottom-color: var(--line); box-shadow: 0 1px 12px rgba(15, 23, 42, .05); }
  nav .wrap { display: flex; align-items: center; gap: 32px; width: 100%; }
  nav .links { display: flex; gap: 26px; font-size: 14.5px; color: var(--text-2); margin-left: 8px; }
  nav .links a:hover { color: var(--blue-600); }
  nav .actions { margin-left: auto; display: flex; align-items: center; gap: 14px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: 10px; font-weight: 600; font-size: 14.5px; cursor: pointer;
    border: none; transition: all .18s ease; white-space: nowrap;
  }
  .btn-primary { background: var(--blue-600); color: #fff; padding: 11px 22px; box-shadow: 0 1px 2px rgba(37, 99, 235, .3), 0 6px 18px -6px rgba(37, 99, 235, .45); }
  .btn-primary:hover { background: #1D4ED8; transform: translateY(-1px); box-shadow: 0 2px 4px rgba(37, 99, 235, .3), 0 10px 26px -8px rgba(37, 99, 235, .55); }
  .btn-ghost-light { background: rgba(255,255,255,.08); color: #E2E8F0; padding: 11px 22px; border: 1px solid rgba(255,255,255,.22); }
  .btn-ghost-light:hover { background: rgba(255,255,255,.16); color: #fff; }
  .btn-outline { background: transparent; color: var(--text-2); padding: 9px 18px; border: 1px solid var(--line); }
  .btn-outline:hover { color: var(--blue-600); border-color: var(--blue-400); background: #EFF6FF; }
  .btn-lg { padding: 14px 30px; font-size: 15.5px; border-radius: 12px; }

  /* ---------- Hero ---------- */
  header.hero {
    position: relative; overflow: hidden; color: #fff;
    background:
      radial-gradient(900px 420px at 78% -10%, rgba(59, 130, 246, .38), transparent 62%),
      radial-gradient(700px 380px at 12% 108%, rgba(14, 165, 233, .22), transparent 60%),
      linear-gradient(158deg, var(--navy-950) 4%, var(--navy-900) 46%, var(--navy-800) 100%);
    padding: 148px 0 96px;
  }
  .hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(148, 163, 184, .055) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(148, 163, 184, .055) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(ellipse 85% 70% at 50% 24%, #000 30%, transparent 78%);
  }
  .hero .wrap { position: relative; display: grid; grid-template-columns: 1.06fr .94fr; gap: 56px; align-items: center; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12.5px; font-weight: 600; letter-spacing: .06em;
    color: #93C5FD; background: rgba(37, 99, 235, .16);
    border: 1px solid rgba(96, 165, 250, .35);
    border-radius: 999px; padding: 6px 14px; margin-bottom: 22px;
  }
  .hero-badge svg { flex: none; }
  .hero h1 {
    font-size: clamp(34px, 4.6vw, 54px); line-height: 1.18; font-weight: 800; letter-spacing: .015em;
    margin-bottom: 20px;
  }
  .hero h1 em { font-style: normal; background: linear-gradient(92deg, #60A5FA, #38BDF8 70%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero p.lead { font-size: 17px; color: #B6C4DB; max-width: 480px; margin-bottom: 34px; }
  .hero .cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-meta { margin-top: 30px; display: flex; gap: 26px; color: #7E92B4; font-size: 13px; }
  .hero-meta b { color: #DCE6F5; font-weight: 600; }

  /* Hero dashboard mock */
  .mock { position: relative; transform: perspective(1400px) rotateY(-7deg) rotateX(2deg); }
  .mock-card {
    background: rgba(255,255,255,.045); border: 1px solid rgba(148,163,184,.22);
    border-radius: 16px; padding: 18px; backdrop-filter: blur(8px);
    box-shadow: 0 30px 70px -22px rgba(3, 10, 24, .8);
  }
  .mock-top { display: flex; align-items: center; gap: 7px; margin-bottom: 14px; }
  .mock-top i { width: 9px; height: 9px; border-radius: 50%; background: rgba(148,163,184,.4); }
  .mock-title { font-size: 12px; color: #8FA3C2; margin-left: 6px; letter-spacing: .08em; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
  .kpi { background: rgba(255,255,255,.05); border: 1px solid rgba(148,163,184,.16); border-radius: 10px; padding: 12px 13px; }
  .kpi small { display: block; color: #7E92B4; font-size: 11px; margin-bottom: 5px; letter-spacing: .04em; }
  .kpi b { font-size: 17px; font-weight: 700; color: #F1F5F9; }
  .kpi span { font-size: 11px; margin-left: 6px; color: #4ADE80; }
  .kpi span.down { color: #F87171; }
  .chart-box { background: rgba(255,255,255,.05); border: 1px solid rgba(148,163,184,.16); border-radius: 10px; padding: 12px; }
  .float-chip {
    position: absolute; display: flex; align-items: center; gap: 9px;
    background: rgba(15, 30, 61, .92); border: 1px solid rgba(96,165,250,.4);
    border-radius: 12px; padding: 10px 14px; font-size: 12.5px; color: #DCE6F5;
    box-shadow: 0 16px 40px -12px rgba(3,10,24,.9); backdrop-filter: blur(6px);
  }
  .float-chip svg { flex: none; }
  .chip-a { top: -20px; right: -14px; animation: bob 5.2s ease-in-out infinite; }
  .chip-b { bottom: -18px; left: -18px; animation: bob 6s ease-in-out .8s infinite; }
  @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }

  /* ---------- Trust bar ---------- */
  .trust { border-bottom: 1px solid var(--line); background: #fff; padding: 26px 0; }
  .trust .wrap { display: flex; align-items: center; gap: 34px; flex-wrap: wrap; justify-content: center; }
  .trust small { color: var(--text-3); font-size: 12.5px; letter-spacing: .12em; font-weight: 600; }
  .trust span { color: var(--text-2); font-weight: 700; font-size: 14.5px; opacity: .62; transition: opacity .2s; letter-spacing: .02em; }
  .trust span:hover { opacity: 1; }

  /* ---------- Sections ---------- */
  section { padding: 88px 0; }
  .sec-head { text-align: center; max-width: 640px; margin: 0 auto 54px; }
  .sec-tag { display: inline-block; color: var(--blue-600); background: #EFF6FF; border: 1px solid #DBEAFE; font-size: 12.5px; font-weight: 700; letter-spacing: .1em; padding: 5px 14px; border-radius: 999px; margin-bottom: 16px; }
  .sec-head h2 { font-size: clamp(26px, 3.2vw, 36px); font-weight: 800; letter-spacing: .01em; margin-bottom: 12px; }
  .sec-head p { color: var(--text-2); font-size: 15.5px; }

  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .feat {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 26px;
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }
  .feat:hover { transform: translateY(-4px); border-color: #BFDBFE; box-shadow: 0 18px 44px -18px rgba(15, 23, 42, .18); }
  .feat .ico {
    width: 44px; height: 44px; border-radius: 11px; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(140deg, #EFF6FF, #DBEAFE); color: var(--blue-600); margin-bottom: 17px;
  }
  .feat.ai .ico { background: linear-gradient(140deg, #FFF7ED, #FFEDD5); color: var(--orange-500); }
  .feat h3 { font-size: 16.5px; font-weight: 700; margin-bottom: 8px; }
  .feat p { color: var(--text-2); font-size: 14px; }

  /* AI banner */
  .ai-banner {
    position: relative; overflow: hidden; border-radius: 22px; color: #fff; padding: 58px 56px;
    background:
      radial-gradient(620px 300px at 88% 0%, rgba(249, 115, 22, .18), transparent 60%),
      radial-gradient(700px 340px at 8% 100%, rgba(59, 130, 246, .3), transparent 62%),
      linear-gradient(140deg, var(--navy-950), var(--navy-800));
  }
  .ai-banner::before {
    content: ""; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(148,163,184,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,.05) 1px, transparent 1px);
    background-size: 40px 40px; mask-image: radial-gradient(ellipse 70% 90% at 50% 50%, #000 20%, transparent 75%);
  }
  .ai-banner .inner { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; }
  .ai-banner h2 { font-size: 27px; font-weight: 800; margin-bottom: 10px; }
  .ai-banner p { color: #B6C4DB; max-width: 560px; font-size: 15px; }
  .ai-tags { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
  .ai-tags span { font-size: 13px; color: #93C5FD; border: 1px solid rgba(96,165,250,.35); background: rgba(37,99,235,.14); padding: 6px 14px; border-radius: 999px; }
  .ai-tags span.o { color: #FDBA74; border-color: rgba(251,146,60,.4); background: rgba(249,115,22,.12); }

  /* Pricing */
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }
  .plan {
    background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 30px 28px;
    display: flex; flex-direction: column; position: relative;
    transition: transform .22s ease, box-shadow .22s ease;
  }
  .plan:hover { transform: translateY(-4px); box-shadow: 0 20px 48px -20px rgba(15, 23, 42, .16); }
  .plan.hot { border: 2px solid var(--blue-600); box-shadow: 0 24px 54px -22px rgba(37, 99, 235, .35); }
  .hot-tag {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
    background: var(--blue-600); color: #fff; font-size: 12px; font-weight: 700;
    padding: 4px 16px; border-radius: 999px; letter-spacing: .06em; white-space: nowrap;
  }
  .plan h3 { font-size: 17px; font-weight: 700; }
  .plan .desc { color: var(--text-3); font-size: 13px; margin: 4px 0 18px; }
  .plan .price { font-size: 40px; font-weight: 800; letter-spacing: -.02em; }
  .plan .price small { font-size: 14px; color: var(--text-3); font-weight: 500; letter-spacing: 0; }
  .plan ul { list-style: none; margin: 20px 0 26px; display: grid; gap: 11px; flex: 1; }
  .plan li { display: flex; gap: 10px; align-items: flex-start; color: var(--text-2); font-size: 14px; }
  .plan li svg { flex: none; margin-top: 3px; }
  .plan .btn { width: 100%; }
  .plan.hot .btn { background: var(--blue-600); color: #fff; padding: 13px 22px; }
  .plan.hot .btn:hover { background: #1D4ED8; }
  .plan:not(.hot) .btn { background: #F1F5F9; color: var(--text); padding: 13px 22px; }
  .plan:not(.hot) .btn:hover { background: #E2E8F0; }

  /* Final CTA */
  .final {
    text-align: center; color: #fff; padding: 74px 32px;
    background:
      radial-gradient(560px 260px at 50% -30%, rgba(59,130,246,.4), transparent 65%),
      linear-gradient(150deg, var(--navy-950), var(--navy-800));
    border-radius: 24px;
  }
  .final h2 { font-size: clamp(26px, 3vw, 34px); font-weight: 800; margin-bottom: 12px; }
  .final p { color: #B6C4DB; margin-bottom: 30px; }

  /* Footer */
  footer { border-top: 1px solid var(--line); padding: 34px 0; color: var(--text-3); font-size: 13.5px; }
  footer .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  footer .logo b { font-size: 16px; }
  footer .fright { display: flex; gap: 22px; }
  footer a:hover { color: var(--blue-600); }

  /* Reveal animation */
  .rv { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
  .rv.in { opacity: 1; transform: none; }

  @media (max-width: 960px) {
    .hero .wrap { grid-template-columns: 1fr; gap: 46px; }
    .mock { transform: none; }
    .grid-3 { grid-template-columns: 1fr 1fr; }
    .plans { grid-template-columns: 1fr; }
    .ai-banner .inner { grid-template-columns: 1fr; }
    nav .links { display: none; }
  }
  @media (max-width: 620px) {
    .grid-3 { grid-template-columns: 1fr; }
    header.hero { padding: 120px 0 72px; }
    .kpis { grid-template-columns: 1fr 1fr; }
  }
</style>
</head>
