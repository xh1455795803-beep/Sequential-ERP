/* ===== JS 内联硬编码色兜底 ===== */
[fill="#f97316"],[fill="#f59e0b"],[fill="#ea580c"],[fill="#c75015"],[fill="#d95d2b"],
[fill="#10b981"],[fill="#14b8a6"],[fill="#22c55e"],[fill="#84cc16"],[fill="#a3e635"]{fill:var(--brand-4)!important}
[fill="#8b5cf6"],[fill="#ec4899"],[fill="#6366f1"]{fill:var(--brand-5)!important}
[stroke="#f97316"],[stroke="#f59e0b"],[stroke="#ea580c"],[stroke="#c75015"],
[stroke="#10b981"],[stroke="#14b8a6"],[stroke="#22c55e"],[stroke="#84cc16"]{stroke:var(--brand-4)!important}
[style*="#f97316"],[style*="#f59e0b"],[style*="#10b981"],[style*="#14b8a6"],[style*="#ea580c"]{color:var(--brand-4)!important}

/* ===== 侧边栏可见性修复（关键）=====
   原设计「深底+白字」；浅色主题下白字不可见，仅对侧边栏作用域重映射为深色。 */
.bg-sidebar .text-white,
.bg-sidebar .text-white\/45,
.bg-sidebar .text-white\/50,
.bg-sidebar .text-white\/55,
.bg-sidebar .text-white\/60,
.bg-sidebar .text-white\/65,
.bg-sidebar .text-white\/70,
.bg-sidebar .text-white\/80,
.bg-sidebar .text-white\/85,
.bg-sidebar .text-white\/90,
.bg-sidebar .text-white\/90{color:var(--sidebar-foreground)!important}
.bg-sidebar .bg-white\/5,.bg-sidebar .bg-white\/10{background-color:oklch(100% 0 0/.55)!important}
.bg-sidebar .border-white\/10,.bg-sidebar .border-white\/15,.bg-sidebar .border-white\/20{border-color:var(--sidebar-border)!important}
