/* ===== Thalvior 晨曦蓝·多元 主题 · 由 nginx 注入，脱离 dist ===== */
:root {
  --radius: .75rem;
  --font-sans: "PingFang SC","Microsoft YaHei","Hiragino Sans GB",ui-sans-serif,system-ui,sans-serif;
  --font-display: "Space Grotesk","PingFang SC","Microsoft YaHei",ui-sans-serif,system-ui,sans-serif;
  --font-mono: "IBM Plex Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;

  /* —— 色阶：由浅到深，多元素化避免单调 —— */
  --brand-1: oklch(90% 0.045 220);
  --brand-2: oklch(80% 0.09 222);
  --brand-3: oklch(72% 0.11 230);
  --brand-4: oklch(64% 0.14 240);
  --brand-5: oklch(56% 0.15 258);
  --brand-6: oklch(50% 0.16 280);
  --brand-7: oklch(62% 0.15 330);
  --ink: oklch(42% .05 257);
  --harbor: oklch(68% .1 230);
  --primary: var(--brand-4);
  --primary-2: var(--brand-6);
  --primary-foreground: oklch(99% .003 240);

  --cargo-orange: var(--brand-4);
  --cargo-teal:   var(--brand-3);
  --cargo-gold:   var(--brand-6);
  --cargo-violet: var(--brand-7);
  --cargo-blue:   var(--brand-5);

  --background: oklch(98.8% .004 238);
  --foreground: oklch(33% .025 255);
  --card: oklch(100% 0 0);
  --card-foreground: oklch(33% .025 255);
  --popover: oklch(100% 0 0);
  --popover-foreground: oklch(33% .025 255);
  --secondary: oklch(96.5% .008 238);
  --secondary-foreground: oklch(38% .05 257);
  --muted: oklch(96.8% .006 238);
  --muted-foreground: oklch(53% .02 252);
  --accent: oklch(95% .03 238);
  --accent-foreground: oklch(45% .13 240);
  --destructive: oklch(58% .18 27);
  --destructive-foreground: oklch(99% .002 27);
  --border: oklch(91.5% .01 238);
  --input: oklch(91.5% .01 238);
  --ring: oklch(64% .125 240);
  --success: oklch(62% .12 230);
  --warning: oklch(72% .11 240);
  --info: oklch(68% .1 222);
  --chart-1: var(--brand-5); --chart-2: var(--brand-4); --chart-3: var(--brand-3); --chart-4: var(--brand-7); --chart-5: var(--brand-2);
  --tone-blue: var(--brand-4);
  --tone-cyan: oklch(68% .12 230);
  --tone-indigo: var(--brand-5);
  --tone-violet: var(--brand-6);
  --tone-rose: var(--brand-7);

  --sidebar: oklch(97.5% .006 238);
  --sidebar-foreground: oklch(33% .025 255);
  --sidebar-primary: var(--brand-4);
  --sidebar-primary-foreground: oklch(99% .003 240);
  --sidebar-accent: oklch(94% .03 238);
  --sidebar-accent-foreground: oklch(40% .12 240);
  --sidebar-border: oklch(91% .01 238);
  --sidebar-ring: oklch(64% .125 240);
  --shadow-soft: 0 1px 2px oklch(42% .05 257/.04),0 1px 3px oklch(42% .05 257/.05);
  --shadow-lift: 0 4px 12px oklch(42% .05 257/.07),0 1px 3px oklch(42% .05 257/.05);
  --shadow-glow: 0 6px 20px oklch(64% .125 240/.24),0 2px 8px oklch(50% .15 280/.16);
  --shadow-float: 0 1px 2px oklch(42% .05 257/.05),0 8px 24px oklch(42% .05 257/.07),0 20px 48px oklch(42% .05 257/.08);
  --shadow-ink: 0 12px 32px oklch(42% .05 257/.16),0 4px 12px oklch(42% .05 257/.1);
}

.bg-ink{background-color:oklch(96.8% .006 238)!important;color:var(--foreground)!important}
.bg-ink :where(h1,h2,h3,h4,p,span,div,a,dt,dd,li,strong,em,small,label,td,th){color:inherit}
.bg-ink .text-white,.bg-ink .text-white\/90,.bg-ink .text-white\/80,.bg-ink .text-white\/70{color:var(--foreground)!important}
.bg-ink .text-white\/60,.bg-ink .text-white\/50,.bg-ink .text-muted-foreground{color:var(--muted-foreground)!important}
.bg-ink .border-white\/10,.bg-ink .border-white\/20,.bg-ink .border-white\/15{border-color:oklch(89% .012 240)!important}
.bg-ink .bg-white\/5,.bg-ink .bg-white\/10{background-color:oklch(100% 0 0/.6)!important}

.grid-texture{background-image:linear-gradient(oklch(42% .05 257/.05) 1px,transparent 1px),linear-gradient(90deg,oklch(42% .05 257/.05) 1px,transparent 1px)!important;background-size:32px 32px,32px 32px!important}

.chip-orange{color:var(--brand-6)!important;background:oklch(64% .125 240/.13)!important}
.chip-teal{color:oklch(50% .12 230)!important;background:oklch(72% .105 230/.16)!important}
.chip-blue{color:var(--brand-5)!important;background:oklch(56% .14 258/.13)!important}
.chip-gold{color:var(--brand-6)!important;background:oklch(50% .15 280/.13)!important}
.chip-violet{color:oklch(50% .13 330)!important;background:oklch(62% .12 330/.14)!important}

.card-glow:after{background:linear-gradient(135deg,oklch(64% .125 240/.55),transparent 40% 60%,oklch(50% .15 280/.35))!important}
.btn-cargo{background:linear-gradient(135deg,var(--primary),var(--primary-2))!important}
.glass-dark{background:oklch(100% 0 0/.72)!important;border:1px solid oklch(90% .012 240)!important;-webkit-backdrop-filter:blur(14px) saturate(1.15)!important;backdrop-filter:blur(14px) saturate(1.15)!important;box-shadow:var(--shadow-float)!important;color:var(--foreground)!important}

html.light,html.light body{background-color:oklch(98.8% .004 238)!important;color:var(--foreground)!important}

.rounded-lg,.rounded-xl,.rounded-md{border-radius:.75rem!important}
.card-glow,.btn-cargo{transition:box-shadow .3s ease,transform .3s ease,border-color .3s ease!important}

