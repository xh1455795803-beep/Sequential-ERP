/* ============================================================
   登录 / 注册页专业化（品牌层 v2 · 深海航运 2026-09-27）
   ⚠️ 实测前提：
     - 登录页 body 无 .auth-page 类（旧品牌层因此 100% 失效）
     - 页面无 <form> 元素，主按钮无 type 属性
     - 主按钮类名是 .btn-cargo
   故全部按实际 DOM 定位，不用 body.auth-page / form / type=submit。
   ============================================================ */

/* ---------- 1) 深色品牌区（aside）航线装饰 ---------- */
[class*="login"] aside,
[class*="Login"] aside,
[class*="auth"] aside,
[class*="Auth"] aside {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(720px 380px at 78% -8%, rgba(234, 88, 12, .20), transparent 62%),
    radial-gradient(640px 340px at 6% 108%, rgba(62, 126, 166, .22), transparent 60%),
    linear-gradient(158deg, #061020 2%, #0B1B33 48%, #112544 100%) !important;
}
/* 航线网格 */
[class*="login"] aside::before,
[class*="Login"] aside::before,
[class*="auth"] aside::before,
[class*="Auth"] aside::before {
  content: "";
  position: absolute; inset: 0; pointer-events: none; z-index: 0;
  background-image:
    linear-gradient(rgba(148, 163, 184, .06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(148, 163, 184, .06) 1px, transparent 1px);
  background-size: 46px 46px;
  -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 22%, #000 30%, transparent 80%);
  mask-image: radial-gradient(ellipse 90% 80% at 50% 22%, #000 30%, transparent 80%);
}
[class*="login"] aside > *,
[class*="Login"] aside > *,
[class*="auth"] aside > *,
[class*="Auth"] aside > * { position: relative; z-index: 1; }

/* ---------- 2) 表单卡片 ---------- */
input[type="text"], input[type="email"], input[type="password"],
input[type="tel"], input[type="number"], input[type="search"],
input:not([type]) {
  border-radius: 10px !important;
  transition: border-color .16s ease, box-shadow .16s ease, background .16s ease !important;
}

/* ---------- 3) 聚焦态：品牌橙描边 + 橙色光晕 ---------- */
input:focus, input:focus-visible, textarea:focus, textarea:focus-visible,
select:focus, select:focus-visible {
  border-color: #EA580C !important;
  box-shadow: 0 0 0 3px rgba(234, 88, 12, .16) !important;
  outline: none !important;
}

/* ---------- 4) 主按钮 hover / active（.btn-cargo） ---------- */
.btn-cargo:hover {
  filter: brightness(1.07) !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 2px 4px rgba(154, 52, 18, .28),
              0 10px 26px -8px rgba(154, 52, 18, .55) !important;
}
.btn-cargo:active { transform: translateY(0) scale(.985) !important; }
.btn-cargo:focus-visible {
  outline: 2px solid #EA580C !important;
  outline-offset: 2px !important;
}

/* ---------- 5) 链接类（忘记密码 / 立即注册）→ 品牌橙 ---------- */
/* ⚠️ 必须排除 .btn-cargo：按钮上的 text-primary-foreground 是"文字颜色"工具类，
      不是"文字链接"语义，命中会导致橙底橙字不可读（2026-09-27 修复） */
a[class*="text-primary"]:not(.btn-cargo),
button[class*="text-primary"]:not(.btn-cargo),
a[class*="text-harbor"]:not(.btn-cargo),
button[class*="text-harbor"]:not(.btn-cargo) {
  color: #C2410C !important;
  font-weight: 600 !important;
}
a[class*="text-primary"]:not(.btn-cargo):hover,
button[class*="text-primary"]:not(.btn-cargo):hover,
a[class*="text-harbor"]:not(.btn-cargo):hover { color: #EA580C !important; }

/* ---------- 6) 全站焦点环 / 选中色 → 品牌橙 ---------- */
* { --tw-ring-color: rgba(234, 88, 12, .35); }
:focus-visible { outline: 2px solid rgba(234, 88, 12, .55); outline-offset: 2px; }
::selection { background: rgba(234, 88, 12, .22); }

/* ---------- 7) 滚动条 ---------- */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: #CBD4E1; border-radius: 6px;
  border: 2px solid transparent; background-clip: content-box;
}
::-webkit-scrollbar-thumb:hover { background-color: #A6B4C6; }

/* ---------- 8) 响应式：小屏收紧 ---------- */
@media (max-width: 620px) {
  input[type="text"], input[type="email"], input[type="password"],
  input[type="tel"], input[type="number"], input:not([type]) {
    font-size: 16px !important; /* 防 iOS 自动缩放 */
  }
  .btn-lg { padding: 13px 22px !important; font-size: 15px !important; }
}

/* ---------- 9) 减少动效偏好 ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
    scroll-behavior: auto !important;
  }
}


/* ============================================================
   终局重申：.btn-cargo 文字恒为白色
   ⚠️ 2026-09-27 修复：前面的 a[class*="text-primary"] 链接规则
      会命中按钮上的 text-primary-foreground 工具类，把白字染成橙色
      → 橙底橙字不可读。此处放在文件最末，靠「后者胜」兜底。
   ============================================================ */
.btn-cargo,
.btn-cargo:visited,
.btn-cargo:hover,
.btn-cargo:focus,
.btn-cargo:focus-visible,
.btn-cargo:active {
  color: #FFFFFF !important;
  background-color: var(--cargo-orange, #C2410C) !important;
  background-image: linear-gradient(135deg, var(--cargo-orange, #C2410C), var(--primary-2, #EA580C)) !important;
  border-color: transparent !important;
}


/* ============================================================
   登录页 Tab 切换（密码登录 / 验证码登录）
   未激活态原为浅灰底 + 深灰字，对比度偏低且与激活态区分度不够。
   规范：激活 = 白底 + 深蓝字 + 轻阴影；未激活 = 透明底 + 中灰字。
   ============================================================ */
[class*="TabsTrigger"],
[class*="tab"][role="tab"],
button[role="tab"] {
  transition: background .18s ease, color .18s ease, box-shadow .18s ease !important;
}
/* 未激活 */
[class*="TabsTrigger"][data-state="inactive"],
button[role="tab"][data-state="inactive"],
button[role="tab"][aria-selected="false"] {
  background: transparent !important;
  color: #64748B !important;
  box-shadow: none !important;
}
[class*="TabsTrigger"][data-state="inactive"]:hover,
button[role="tab"][data-state="inactive"]:hover,
button[role="tab"][aria-selected="false"]:hover {
  color: #0F172A !important;
  background: rgba(148, 163, 184, .10) !important;
}
/* 激活 */
[class*="TabsTrigger"][data-state="active"],
button[role="tab"][data-state="active"],
button[role="tab"][aria-selected="true"] {
  background: #FFFFFF !important;
  color: #0F172A !important;
  font-weight: 600 !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, .12), 0 1px 2px rgba(15, 23, 42, .06) !important;
}


/* ============================================================
   图表调色板归位到品牌色（2026-09-27）
   应用原生 --chart-1 是蓝色 oklch(55% .13 262)，
   导致仪表盘环形图、销售走势图主色显蓝，与品牌脱节。
   现按「深海航运」规范重排：暖橙打头，与侧边栏/按钮/统计卡一致。
   ============================================================ */
:root, .dark, [data-theme] {
  --chart-1: oklch(58% .165 42);   /* 品牌暖橙（图表主色） */
  --chart-2: oklch(50% .085 230);  /* 海港青 */
  --chart-3: oklch(25% .045 258);  /* 深海蓝 */
  --chart-4: oklch(70% .14 75);    /* 琥珀（警告） */
  --chart-5: oklch(72% .13 55);    /* 浅橙 */
}


/* ============================================================
   登录页左栏 eyebrow 对比度修复（WCAG AA，2026-09-27）
   实测 'GLOBAL ROUTES · 全球航线'：text-white/45，11px，
   深海底 rgb(20,34,55) 上对比度仅 4.34:1 < AA 要求 4.5:1 → 提至 72%（≈7.1:1）。

   ⚠️ 必须写进 @layer utilities。
   应用规则 `.\!text-white\/45 { color:#ffffff73 !important }` 位于
   @layer utilities 内且自带 !important。级联排序为
   【important → 层 → 特异性 → 出现顺序】，且在 important 组内层序是反的：
   分层 important 优先于未分层 important。写在层外必输（已实测无效）。
   进同一层后，靠更高特异性 (0,2,0) > (0,1,0) 取胜。
   ============================================================ */
@layer utilities {
  .manifest-eyebrow.\!text-white\/45,
  [class*="text-white/45"] {
    color: rgba(255, 255, 255, .72) !important;
  }
}
