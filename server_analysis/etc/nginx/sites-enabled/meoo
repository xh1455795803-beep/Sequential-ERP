server_tokens off;
server {
    server_name thalvior.icu;

    # ===== 自定义主题 CSS（脱离 dist，部署不覆盖）=====


    # ===== 自定义增强 JS（脱离 dist，部署不覆盖）=====


    # ===== AI 计费文案积分口径覆盖层 =====






    # 1) 注入自定义增强 JS（必须在 head 中、前端 module 脚本之前执行，用于修复 fetch this 绑定）

    # 2) 注入自定义主题 CSS（在原 CSS 之后，靠层叠覆盖）

    # 3) favicon → Thalvior 品牌（深海底 + 暖橙菱形，2026-09-27 修正）

    # 4) JS 内图表配色 -> 美式蓝灰系
    # 图表 8 色调色板 → Thalvior 品牌色（暖橙 / 海港青 / 深海蓝，2026-09-27 修正）

    root /var/www/meoo;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml+rss;
    gzip_min_length 1024;

    # ===== 自建 Supabase 网关反代 =====
    location /rest/v1/ {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /auth/v1/ {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /storage/v1/ {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /functions/v1/ {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /realtime/v1/ {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ===== 合规页（隐私政策 / 用户协议）=====
    location = /privacy {
        root /var/www/legal;
        try_files /privacy.html =404;
        default_type text/html;
        include /etc/nginx/conf.d/security-headers.conf;
    }
    location = /terms {
        root /var/www/legal;
        try_files /terms.html =404;
        default_type text/html;
        include /etc/nginx/conf.d/security-headers.conf;
    }
    # ===== 订阅 / AI 积分中心：独立真实页面（数据源：Supabase REST）=====
    location = /subscription {
        include /etc/nginx/conf.d/security-headers.conf;
        root /var/www/subscribe;
        try_files /index.html =404;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Expires "0" always;
        add_header Pragma "no-cache" always;
    }
    location = /subscribe {
        include /etc/nginx/conf.d/security-headers.conf;
        return 301 /subscription;
    }

    # ===== 发票管理：独立真实页面（财务中心子功能）=====
    location = /finance/invoice {
        include /etc/nginx/conf.d/security-headers.conf;
        root /var/www/invoice;
        try_files /index.html =404;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Expires "0" always;
        add_header Pragma "no-cache" always;
    }
    location = /finance/invoices {
        include /etc/nginx/conf.d/security-headers.conf;
        return 301 /finance/invoice;
    }

    # ===== 营销落地页（根路径 + /index.html 统一，带登录态检测） =====
    location = / {
        include /etc/nginx/conf.d/security-headers.conf;
        root /var/www/landing;
        try_files /index.html =404;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Expires "0" always;
        add_header Pragma "no-cache" always;
    }
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.conf;
        root /var/www/landing;
        try_files /index.html =404;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Expires "0" always;
        add_header Pragma "no-cache" always;
    }
    # SPA 前端路由回退：命名 location 仅供内部跳转，避免被 /index.html 精确匹配劫持
    location @spa {
        include /etc/nginx/conf.d/security-headers.conf;
        root /var/www/meoo;
        try_files /index.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Expires "0" always;
        add_header Pragma "no-cache" always;
    }

    # SPA 静态资源：带 hash，长缓存
    # >>> thalvior 订购页 chunk 覆盖发布（幂等块）
    # <<< thalvior 订购页 chunk
    # >>> thalvior cache-bust 20260929
    # <<< thalvior cache-bust 20260929
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA 前端路由回退：HTML 不缓存，确保每次拉最新；回退指向命名 location @spa
    
  
  # >>> thalvior final-theme 20260929
  # <<< thalvior final-theme 20260929

  location / {
      include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Expires "0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ @spa;
    }

    # 安全头（统一注入，见 conf.d/security-headers.conf）
    include /etc/nginx/conf.d/security-headers.conf;

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/thalvior.icu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/thalvior.icu/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = thalvior.icu) {
        return 301 https://$host$request_uri;
    }

    listen 80 default_server;
    listen [::]:80 default_server;
    server_name thalvior.icu;
    return 404;
}
