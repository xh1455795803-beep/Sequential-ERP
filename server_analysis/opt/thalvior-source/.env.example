# ============================================================
# Thalvior 跨境 ERP · 环境变量清单
# 说明：本文件只列出「键名 + 用途 + 获取方式」，不含任何真实密钥。
#       真实密钥保存在服务器 /opt/supabase/docker/.env 与 compose 的 functions.environment 中，不进源码。
# ============================================================


# ---------- 一、Supabase 运行时自动注入（无需手配）----------
# 以下变量由 Supabase 容器环境自动提供给 Edge Function，部署后即可读取：
#   SUPABASE_URL              Supabase 网关地址
#   SUPABASE_SERVICE_ROLE_KEY service_role 密钥（服务端互调用）
#   SUPABASE_JWKS             JWT 公钥集
#   SUPABASE_PUBLIC_URL       对外访问地址
#   JWT_SECRET                JWT 签名密钥
#   VERIFY_JWT                JWT 校验开关


# ---------- 二、必须手动配置（缺一项对应功能即不可用）----------

# —— AI（阿里云百炼，已彻底脱离 Meoo 云）——
DASHSCOPE_API_KEY=          # 百炼 API Key，AI 对话/视觉/图片生成/采集解析统一凭证
BAILIAN_EDIT_MODEL=         # 可选：指定文案润色模型 ID，留空用默认
MEOO_PROJECT_API_KEY=       # 可选：项目级凭证覆盖；MEOO_PROJECT_API_KEY_<项目ID> 可再按项目覆盖

# —— 邮件（mailer / email-otp，QQ 邮箱 SMTP 465 直连 SSL）——
SMTP_HOST=                  # 如 smtp.qq.com
SMTP_PORT=                  # 465
SMTP_USER=                  # 发信邮箱全称
SMTP_PASS=                  # 邮箱「授权码」，不是登录密码
SMTP_FROM=                  # 发信人地址（通常与 SMTP_USER 一致）
SMTP_FROM_NAME=             # 发信人显示名，如 Thalvior
MAILER_SECRET=              # 服务端互调共享密钥（functions 之间调用 mailer 时校验），建议 48 位随机串
SUPPORT_EMAIL=              # 客服邮箱，展示在邮件页脚与「客服咨询」面板
SITE_URL=                   # 站点地址，邮件正文链接用
OTP_MINUTES=                # 邮箱验证码有效期（分钟），默认 5

# —— 阿里云短信 ——
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=       # 短信签名
ALIYUN_SMS_TEMPLATE_CODE=   # 验证码模板 CODE
GOTRUE_SMS_HOOK_SECRET=     # GoTrue SMS Hook 校验密钥（gotrue-sms 函数用）

# —— 微信支付（7 项全填才能下单/回调验签）——
WECHAT_APP_ID=              # 公众号/移动应用 AppID
WECHAT_MCH_ID=              # 商户号
WECHAT_API_V3_KEY=          # API v3 密钥
WECHAT_SERIAL_NO=           # 商户证书序列号
WECHAT_PRIVATE_KEY=         # 商户 API 私钥（PEM，多行需转义换行）
WECHAT_PUB_KEY=             # 微信支付平台证书公钥
WECHAT_PUB_KEY_ID=          # 平台证书公钥 ID

# —— 汇率（exchange-rate 函数）——
EXCHANGERATE_API_KEY=       # 汇率数据源 API Key


# ---------- 三、运维脚本变量（本地跑 smoke/ops 脚本时才需要，不入库）----------
# SSH_PASSWORD=              服务器 SSH 密码（scripts/smoke/*.mjs、scripts/ops/*.py 用）
# MAIL_PASSWORD=             邮箱授权码（邮件收发调试脚本用）


# ---------- 四、前端变量（src/.env，构建时注入，非敏感）----------
# VITE_SUPABASE_URL=          Supabase 公网地址
# VITE_SUPABASE_ANON_KEY=     anon key（设计为公开，配合 RLS 使用）
# VITE_ONEDAY_APP_ID=         项目标识


# ============================================================
# 部署位置说明
#   · 二、三 中的变量需写入服务器 /opt/supabase/docker/.env，
#     并同步到 docker-compose.yml 的 functions.environment 段（compose 以 ${VAR} 模板注入容器）
#   · 改完执行：cd /opt/supabase/docker && sudo docker compose up -d functions
#   · 注意：compose 用 ${VAR} 引用的是 .env 里的实际值，只改模板不生效
# ============================================================
