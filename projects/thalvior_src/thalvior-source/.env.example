# ============================================================
# Thalvior 跨境 ERP · 环境变量清单
# 说明：本文件只列出「键名 + 用途 + 获取方式」，不含任何真实密钥。
#       真实密钥保存在服务器 /opt/supabase/docker/.env 与 compose 的 functions.environment 中，不进源码。
# ============================================================


# ---------- 一、Supabase 运行时自动注入（无需手配）----------
# 以下变量由 Supabase 容器环境自动提供给 Edge Function，部署后即可读取：
#   SUPABASE_URL              Supabase 网关地址
#   SUPABASE_SERVICE_ROLE_KEY service_role 密钥（服务端互调用）
#   SUPABASE_JWKS             JWT 公钥集
#   SUPABASE_PUBLIC_URL       对外访问地址
#   JWT_SECRET                JWT 签名密钥
#   VERIFY_JWT                JWT 校验开关


# ---------- 二、必须手动配置（缺一项对应功能即不可用）----------

# —— AI（阿里云百炼，已彻底脱离 Meoo 云）——
DASHSCOPE_API_KEY=
BAILIAN_EDIT_MODEL=
MEOO_PROJECT_API_KEY=

# —— 邮件（mailer / email-otp，QQ 邮箱 SMTP 465 直连 SSL）——
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
MAILER_SECRET=
SUPPORT_EMAIL=
SITE_URL=
OTP_MINUTES=

# —— 阿里云短信 ——
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
GOTRUE_SMS_HOOK_SECRET=

# —— 微信支付（7 项全填才能下单/回调验签）——
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PUB_KEY=
WECHAT_PUB_KEY_ID=

# —— 汇率（exchange-rate 函数）——
EXCHANGERATE_API_KEY=


# ---------- 三、运维脚本变量（本地跑 smoke/ops 脚本时才需要，不入库）----------
# SSH_PASSWORD=              服务器 SSH 密码（scripts/smoke/*.mjs、scripts/ops/*.py 用）
# MAIL_PASSWORD=             邮箱授权码（邮件收发调试脚本用）


# ---------- 四、前端变量（src/.env，构建时注入，非敏感）----------
# VITE_SUPABASE_URL=          Supabase 公网地址
# VITE_SUPABASE_ANON_KEY=     anon key（设计为公开，配合 RLS 使用）
# VITE_ONEDAY_APP_ID=         项目标识


# ============================================================
# 部署位置说明
#   · 二、三 中的变量需写入服务器 /opt/supabase/docker/.env，
#     并同步到 docker-compose.yml 的 functions.environment 段（compose 以 ${VAR} 模板注入容器）
#   · 改完执行：cd /opt/supabase/docker && sudo docker compose up -d functions
#   · 注意：compose 用 ${VAR} 引用的是 .env 里的实际值，只改模板不生效
# ============================================================

# ---------- 五、合规主体信息（wave B 20261117 · 前端构建期注入，非敏感） ----------
# 说明：这些值会出现在公开页脚 / 法务页，属于对外公示信息，可公开。
# 未填写时前端渲染中文占位（见 src/lib/company.ts），上线前必须补全。
# 同时需要同步到静态页：ops/scripts/fill-legal.sh 会一次性替换
#   /var/www/landing/index.html 与 /var/www/legal/*.html 中的占位。
VITE_COMPANY_NAME=（公司名待补）
VITE_USCC=（统一社会信用代码待补）
VITE_ICP_FILING=（ICP 备案号待补）
VITE_POLICE_FILING=（公安备案号待补）
VITE_ADDRESS=（注册地址待补）
VITE_PHONE=（客服电话待补）
VITE_LEGAL_REP=（法定代表人待补）
VITE_SUPPORT_EMAIL=thalvior@foxmail.com
