# ── Core ──
APP_ENV=prod
APP_PORT=8787
# SQLite for dev/prod single-host. Switch to Postgres when multi-node:
# DATABASE_URL=postgresql://user:pass@host:5432/platform_hub
DATABASE_URL=sqlite:////data/platform_hub.db

# ⚠️ MUST CHANGE - 32 bytes minimum. Use: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=change-this-to-a-random-32-byte-key-now!!

# ── OAuth (set only for platforms you actually use) ──
# Shopify - register at https://partners.shopify.com/
# App URL: https://yourdomain.com, Whitelisted redirect URI: https://yourdomain.com/api/oauth/shopify/callback
SHOPIFY_APP_KEY=
SHOPIFY_APP_SECRET=
OAUTH_REDIRECT_BASE=https://yourdomain.com

# ── Optional: timezone ──
TZ=Asia/Shanghai
